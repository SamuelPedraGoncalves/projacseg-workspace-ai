{
  "name": "projacseg-workspace-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ProjacSeg Workspace AI — inteligência operacional sobre o Bitrix24 (TechStone Consultoria).",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @projacseg/web dev",
    "dev:api": "pnpm --filter @projacseg/api dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @projacseg/web test:e2e",
    "portal": "pnpm build && pnpm --filter @projacseg/api start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
