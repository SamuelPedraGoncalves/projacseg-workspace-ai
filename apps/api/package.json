{
  "name": "@projacseg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend do ProjacSeg Workspace AI (esqueleto: health check e portas de integração).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
