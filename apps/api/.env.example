# API — copie para apps/api/.env e preencha localmente. Nunca versione o .env.

NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3333
LOG_LEVEL=info

# --- Banco de dados (PostgreSQL + pgvector) -----------------------------------------------
# Local: pnpm db:up && pnpm db:migrate. Sem DATABASE_URL os dados ficam em memória (só testes).
DATABASE_URL=postgresql://workspace:workspace_local@127.0.0.1:5432/projacseg_workspace

# --- Segredos (gere valores novos; nunca reutilize os de exemplo) -------------------------
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Bitrix24 (portal de TESTES; produção só com autorização) -----------------------------
BITRIX24_ALLOWED_DOMAINS=seu-portal-de-testes.bitrix24.com.br
# Do aplicativo local (necessários para renovar tokens e rodar o motor sem ninguém logado)
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
BITRIX24_ASSISTANT_BOT_CODE=projacseg_assistant
# Opcional: fixa o application_token esperado nos eventos
# BITRIX24_APPLICATION_TOKEN=

# --- Motor de regras ------------------------------------------------------------------------
ENGINE_ENABLED=true
ENGINE_TICK_SECONDS=60
ENGINE_FULL_SYNC_MINUTES=30

# --- Assistente de IA (desligado por padrão) ----------------------------------------------
# "anthropic" liga o Claude no chat; a empresa também precisa de "aiEnabled": true em tenants/.
AI_PROVIDER=none
AI_MODEL=claude-opus-5-5
# Chave da Anthropic (ou use `ant auth login` na máquina do servidor)
# ANTHROPIC_API_KEY=
# true = títulos de negócios (nomes de segurados) não são enviados à IA
AI_REDACT_CLIENT_NAMES=true

# Opcional
# WEB_DIST_DIR=../web/dist
# TENANTS_DIR=./tenants
