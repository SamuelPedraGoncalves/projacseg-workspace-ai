# API — copie para apps/api/.env e preencha localmente. Nunca versione o .env.

NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3333
LOG_LEVEL=info

# Portal(is) Bitrix24 de TESTES autorizados, separados por vírgula. Nunca o portal de produção sem
# autorização. Eventos de outros portais são recusados; o iframe só é liberado para estes domínios.
BITRIX24_ALLOWED_DOMAINS=seu-portal-de-testes.bitrix24.com.br

# Opcional: fixa o application_token esperado nos eventos do bot.
# BITRIX24_APPLICATION_TOKEN=

# Código do bot do assistente (igual ao VITE_BITRIX24_ASSISTANT_BOT_CODE do frontend)
BITRIX24_ASSISTANT_BOT_CODE=projacseg_assistant

# Opcional: pasta do build do frontend (padrão: ../web/dist)
# WEB_DIST_DIR=

# Futuro: PostgreSQL (com pgvector) — ainda não utilizado
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/projacseg_workspace
