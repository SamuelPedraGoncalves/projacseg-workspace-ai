// RASCUNHO DE MODELAGEM — NÃO APLICADO.
// O Prisma ainda não está instalado nesta sprint (primeira entrega = frontend). Este arquivo registra a
// modelagem prevista para revisão. Ver docs/ARCHITECTURE.md e docs/ROADMAP.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Empresa cliente (um portal Bitrix24).
model Tenant {
  id               String            @id @default(cuid())
  name             String
  bitrixDomain     String            @unique
  bitrixMemberId   String            @unique
  createdAt        DateTime          @default(now())
  themePreferences ThemePreference[]
  occurrences      Occurrence[]
}

/// Preferência de tema por colaborador. Um colaborador nunca altera o tema de outro.
model ThemePreference {
  id           String   @id @default(cuid())
  tenantId     String
  bitrixUserId String
  baseColor    String   @db.VarChar(7)
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, bitrixUserId])
}

/// Ocorrência operacional (atraso, escalonamento…). Histórico imutável e auditável.
model Occurrence {
  id           String            @id @default(cuid())
  tenantId     String
  bitrixDealId String
  ruleCode     String
  responsibleId String
  status       String
  createdAt    DateTime          @default(now())
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  events       OccurrenceEvent[]

  @@index([tenantId, bitrixDealId])
}

/// Linha do tempo da ocorrência (somente inserção).
model OccurrenceEvent {
  id           String     @id @default(cuid())
  occurrenceId String
  type         String
  actor        String
  payload      Json
  createdAt    DateTime   @default(now())
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id])

  @@index([occurrenceId, createdAt])
}
