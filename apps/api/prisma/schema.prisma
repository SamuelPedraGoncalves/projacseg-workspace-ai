// Modelo de dados do Workspace AI (PostgreSQL). Migrações em prisma/migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Empresa cliente = um portal Bitrix24.
model Tenant {
  id                String    @id @default(cuid())
  domain            String    @unique
  memberId          String    @unique
  clientEndpoint    String
  /// Conferido em todo evento recebido do portal.
  applicationToken  String?
  /// Tokens OAuth do aplicativo, criptografados (AES-256-GCM). Nunca em texto puro.
  accessTokenEnc    String?
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  /// Usuário do Bitrix24 que instalou o app (administrador do WorkSeg). Mantido nas reinstalações.
  installedByUserId String?
  /// Calendário útil, mapeamento de campos, horário do resumo diário, IA ligada/desligada.
  config            Json
  installedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  rules            Rule[]
  deals            DealSnapshot[]
  occurrences      Occurrence[]
  themePreferences ThemePreference[]
  notifications    NotificationLog[]
  assistantActions AssistantAction[]
  roles            TenantRole[]
  consents         ConsentRecord[]
}

/// Regra operacional configurável (ver packages/engine/src/rules.ts).
model Rule {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  definition  Json
  enabled     Boolean
  homologated Boolean
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

/// Última fotografia conhecida de cada negócio do CRM.
model DealSnapshot {
  tenantId        String
  dealId          String
  title           String
  categoryId      String
  categoryName    String
  stageId         String
  stageName       String
  stageEnteredAt  DateTime
  assignedById    String
  responsibleName String
  branch          String?
  insuranceType   String?
  closed          Boolean
  /// Só os campos usados pelas regras (UF_CRM_* → valores). Ver packages/engine/src/rules.ts.
  fields          Json?
  syncedAt        DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, dealId])
  @@index([tenantId, assignedById])
}

/// Ocorrência operacional (prazo de uma regra para uma passagem do negócio por uma etapa).
model Occurrence {
  id              String            @id @default(cuid())
  tenantId        String
  dealId          String
  ruleCode        String
  stageId         String
  stageEnteredAt  DateTime
  responsibleId   String
  openedAt        DateTime
  dueAt           DateTime
  riskAt          DateTime
  /// open | at_risk | overdue | resolved
  status          String
  escalationLevel Int               @default(0)
  resolvedAt      DateTime?
  resolveReason   String?
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events          OccurrenceEvent[]

  @@unique([tenantId, dealId, ruleCode, stageEnteredAt])
  @@index([tenantId, status])
  @@index([tenantId, responsibleId])
}

/// Histórico auditável — somente inserção (sem update/delete pela aplicação).
model OccurrenceEvent {
  id           String     @id @default(cuid())
  occurrenceId String
  tenantId     String
  type         String
  actor        String
  payload      Json
  createdAt    DateTime   @default(now())
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([occurrenceId, createdAt])
}

/// Mensagens enviadas (evita alertas duplicados e registra o que foi comunicado).
model NotificationLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  kind      String
  dedupeKey String
  sentAt    DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
}

/// Ações pedidas ao assistente no chat (mover etapa, preencher campo): proposta, confirmação e
/// resultado. Também é o registro de auditoria do que a IA alterou no CRM e a pedido de quem.
model AssistantAction {
  id        String    @id @default(cuid())
  tenantId  String
  /// Colaborador que pediu (ID do usuário no Bitrix24).
  userId    String
  dealId    String
  /// stage | field
  kind      String
  /// Alteração validada pelo servidor (ex.: {"STAGE_ID":"UC_IYS6WC"}).
  payload   Json
  /// Texto mostrado ao colaborador na confirmação.
  summary   String
  /// pending | executed | cancelled | expired | failed
  status    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  decidedAt DateTime?
  result    String?
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
}

/// Preferência de tema por colaborador.
model ThemePreference {
  id           String   @id @default(cuid())
  tenantId     String
  bitrixUserId String
  baseColor    String   @db.VarChar(7)
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bitrixUserId])
}

/// Papéis dados dentro do WorkSeg (ex.: quem pode criar regras), escolhidos pelo administrador.
model TenantRole {
  id        String   @id @default(cuid())
  tenantId  String
  /// ID do usuário no Bitrix24.
  userId    String
  userName  String
  /// rule_editor
  role      String
  grantedBy String
  grantedAt DateTime
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, userId])
}

/// Aceites de termos e avisos (somente inserção): quem aceitou, qual versão e quando.
model ConsentRecord {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  /// terms | privacy_notice
  kind        String
  version     String
  provisional Boolean
  acceptedAt  DateTime
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, userId, acceptedAt])
}
