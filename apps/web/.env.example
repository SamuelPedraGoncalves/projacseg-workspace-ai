# Frontend — apenas valores públicos (tudo com prefixo VITE_ vai para o navegador).
# Nunca coloque tokens, segredos ou credenciais do Bitrix24 aqui.

# Usuário do modo demonstrativo (fora do Bitrix24; dados fictícios)
VITE_DEMO_TENANT_ID=projacseg-demo
VITE_DEMO_USER_ID=demo-lucas
VITE_DEMO_USER_NAME=Lucas
VITE_DEMO_USER_INITIALS=LC
# Opcional: foto do usuário demonstrativo. Dentro do Bitrix24 a foto vem do perfil (user.current).
# VITE_DEMO_USER_PHOTO_URL=

# O código do bot do assistente fica só no servidor (BITRIX24_ASSISTANT_BOT_CODE em apps/api/.env).
